NEXT_PUBLIC_GEMINI_API_KEY=

# Supabase Auth. Use the publishable (anon) key only - never the service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AYABOT FastAPI backend origin (server-only; the /api/v1 prefix is added by the API client).
AYABOT_API_URL=http://localhost:8000
