# Supabase Auth. Use the publishable (anon) key only - never the service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AYABOT FastAPI backend origin. Server-only: never prefix this variable with NEXT_PUBLIC_.
AYABOT_API_URL=http://localhost:8000

# Product credential used only by the Next.js voice ticket route. Server-only and secret.
AYABOT_PRODUCT_API_KEY=replace-with-product-api-key

# Browser-visible FastAPI voice WebSocket endpoint. This is an address, not a credential.
# Use wss:// outside local development.
NEXT_PUBLIC_AYABOT_VOICE_WS_URL=ws://localhost:8000/api/v1/voice/ws
